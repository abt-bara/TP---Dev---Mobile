<?xml version="1.0" encoding="utf-8"?>
<!-- OUTER: LinearLayout stacks its children in one direction (vertical here) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title sits at the top of the vertical stack -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quiz App"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <!-- INNER: RelativeLayout positions children relative to each other
         layout_weight="1" makes it fill the remaining space under the title -->
    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Question 1 of 3"
        android:textSize="14sp"
        android:paddingBottom="4dp" />

    <!-- The bar itself. The style makes it a flat horizontal bar
         (without it, you get a spinning circle) -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:max="3"
        android:progress="0" />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Question: placed at the top of the RelativeLayout -->
        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:text="What is the capital of Tunisia?"
            android:textSize="20sp"
            android:paddingBottom="16dp" />

        <!-- Answers: RadioGroup is placed BELOW the question -->
        <RadioGroup
            android:id="@+id/rgAnswers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvQuestion"
            android:layout_marginTop="119dp">

            <RadioButton
                android:id="@+id/rbOption1"
                android:layout_width="190dp"
                android:layout_height="89dp"
                android:text="Tunis" />

            <RadioButton
                android:id="@+id/rbOption2"
                android:layout_width="190dp"
                android:layout_height="98dp"
                android:text="Sfax" />

            <RadioButton
                android:id="@+id/rbOption3"
                android:layout_width="194dp"
                android:layout_height="wrap_content"
                android:text="Sousse" />
        </RadioGroup>


    </RelativeLayout>

    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnSubmit"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPrevious"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_previous" />

        <Button
            android:id="@+id/btnRestart"
            android:layout_width="154dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_restart" />
        <Button
            android:id="@+id/btnNext"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_next" />
    </LinearLayout>


    <!-- Submit button: glued to the bottom of the RelativeLayout -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="@string/btn_submit" />
</LinearLayout>